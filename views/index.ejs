<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Daftar Siswa</h1>

    <form action="" method="get">
        <label>NIS</label>
        <input type="text" name="nis" value="<%=query.nis%>">

        <label>Name</label>
        <input type="text" name="name" value="<%=query.name%>">

        <label>Address</label>
        <input type="text" name="address" value="<%=query.address%>">

        <button class="btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Cari</button>
        <a href="/" class="btn" style="background-color: hsl(63, 52%, 25%);"><i
                class="fa-solid fa-arrow-rotate-left"></i>Reset</a>
    </form>
    <hr>

    <a href="/add" class="btn"> <i class="fa-solid fa-plus"></i>Tambah</a>
    <link rel="stylesheet" href="/fontawesome/css/all.min.css">
    <table>
        <tr>
            <th><i class="fa-solid fa-sort"></i>Nis</th>
            <th>Nama</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
        <% data.forEach(item=> { %>
            <tr>
                <td>
                    <%= item.nis %>
                </td>
                <td>
                    <%= item.name %>
                </td>
                <td>
                    <%= item.address %>
                </td>
                <td>
                    <a href="/edit/<%= item.nis %>"><i class="fa-solid fa-pen-to-square"></i></a>
                    <a href="/delete/<%= item.nis %>" onclick="return confirm('Yakin?')">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </td>
            </tr>
            <% }) %>
    </table>

</body>

</html>